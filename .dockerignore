# Allowlist: never send worktrees, host data, credentials or local artifacts.
**
!Dockerfile
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!.npmrc
!tsconfig.base.json
!LICENSE
!THIRD_PARTY_NOTICES.md
!apps/
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/*.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!apps/server/
!apps/server/package.json
!apps/server/tsconfig.json
!apps/server/src/
!apps/server/src/**
!packages/
!packages/shared/
!packages/shared/package.json
!packages/shared/tsconfig.json
!packages/shared/src/
!packages/shared/src/**
# Never overlay Linux-installed dependencies with host links or build artifacts.
**/node_modules
**/dist
**/.vite
**/*.tsbuildinfo
**/.env*
**/*.pem
**/*.key
!apps/web/tsconfig.json
!apps/web/env.d.ts
!apps/web/eslint.config.js
!apps/server/eslint.config.js
